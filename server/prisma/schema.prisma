generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Nivel de prioridad tipado
enum Priority {
  LOW
  MEDIUM
  HIGH
}

// 2. Modelo de Columna
model Column {
  id        String   @id @default(uuid())
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks     Task[]
}

// 3. Modelo de Tarea
model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  priority    Priority  @default(MEDIUM)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  columnId    String
  column      Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)
}
